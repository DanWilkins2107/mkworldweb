{
  "rules": {
    "players": {
      ".read": true,
      ".write": "!newData.exists()",
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['name', 'slackName', 'avatar'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "slackName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().matches(/^(baby-daisy|baby-luigi|baby-mario|baby-peach|baby-rosalina|birdo|bowser|bowser-jr|cataquack|chargin-chuck|cheep-cheep|coin-coffer|conkdor|cow|daisy|dolphin|donkey-kong|dry-bones|fish-bone|goomba|hammer-bro|king-boo|koopa-troopa|lakitu|luigi|mario|monty-mole|nabbit|para-biddybud|pauline|peach|peepa|penguin|pianta|piranha-plant|pokey|pro-racer-toad|rocky-wrench|rosalina|shy-guy|sidestepper|snowman|spike|stingby|swoop|toad|toadette|waluigi|wario|wiggler|yoshi)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tournament": {
      ".read": true,
      ".write": true,
      "status": {
        ".validate": "newData.isString() && newData.val().matches(/^(not-started|in-progress|finished)$/)"
      },
      "currentWeek": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
      },
      "weeks": {
        "$week": {
          ".validate": "$week.matches(/^([1-9]|[12][0-9]|30)$/) && newData.hasChildren(['trackSlug'])",
          "trackSlug": {
            ".validate": "newData.isString() && newData.val().matches(/^(acorn-heights|airship-fortress|boo-cinema|bowsers-castle|cheep-cheep-falls|choco-mountain|crown-city|dandelion-depths|desert-hills|dino-dino-jungle|dk-pass|dk-spaceport|dry-bones-burnout|faraway-oasis|great-question-block-ruins|koopa-troopa-beach|mario-bros-circuit|mario-circuit|moo-moo-meadows|peach-beach|peach-stadium|rainbow-road|salty-salty-speedway|shy-guy-bazaar|sky-high-sundae|starview-peak|toads-factory|wario-shipyard|wario-stadium|whistlestop-summit)$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "times": {
      ".read": true,
      ".write": "!newData.exists()",
      "$week": {
        ".write": "$week.matches(/^([1-9]|[12][0-9]|30)$/)",
        "$playerId": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1800000"
        }
      }
    },
    "recordsPlayers": {
      ".read": true,
      ".write": "!newData.exists()",
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['name', 'avatar'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().matches(/^(baby-daisy|baby-luigi|baby-mario|baby-peach|baby-rosalina|birdo|bowser|bowser-jr|cataquack|chargin-chuck|cheep-cheep|coin-coffer|conkdor|cow|daisy|dolphin|donkey-kong|dry-bones|fish-bone|goomba|hammer-bro|king-boo|koopa-troopa|lakitu|luigi|mario|monty-mole|nabbit|para-biddybud|pauline|peach|peepa|penguin|pianta|piranha-plant|pokey|pro-racer-toad|rocky-wrench|rosalina|shy-guy|sidestepper|snowman|spike|stingby|swoop|toad|toadette|waluigi|wario|wiggler|yoshi)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "personalBests": {
      ".read": true,
      ".write": "!newData.exists()",
      "$trackSlug": {
        ".write": "$trackSlug.matches(/^(acorn-heights|airship-fortress|boo-cinema|bowsers-castle|cheep-cheep-falls|choco-mountain|crown-city|dandelion-depths|desert-hills|dino-dino-jungle|dk-pass|dk-spaceport|dry-bones-burnout|faraway-oasis|great-question-block-ruins|koopa-troopa-beach|mario-bros-circuit|mario-circuit|moo-moo-meadows|peach-beach|peach-stadium|rainbow-road|salty-salty-speedway|shy-guy-bazaar|sky-high-sundae|starview-peak|toads-factory|wario-shipyard|wario-stadium|whistlestop-summit)$/)",
        "$playerId": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1800000"
        }
      }
    }
  }
}
