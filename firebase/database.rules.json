{
  "rules": {
    "players": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() && newData.exists() && root.child('players').numChildren() < 30",
        ".validate": "newData.hasChildren(['name', 'avatar'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "slackName": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 50)"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().matches(/^(mario|luigi|peach|bowser)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
